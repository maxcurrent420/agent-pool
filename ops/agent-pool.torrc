# Agent Pool Tor daemon config — rendered by scripts/lib/tor-config.sh.
# Installed as /etc/tor/agent-pool.torrc; /etc/tor/torrc is never changed.
# Operator install hints (advisory only; the operator-run scripts do this):
#   sudo install -m 600 <rendered file> /etc/tor/agent-pool.torrc
#   sudo systemctl enable --now agent-pool-tor
# The daemon runs as the gateway user (User= in the unit), so only that
# user and children it starts can read the control cookie.

DataDirectory @DATA_DIR@
CookieAuthentication 1
CookieAuthFile @DATA_DIR@/control_auth_cookie
CookieAuthFileGroupReadable 0
DataDirectoryGroupReadable 0
ControlPort 127.0.0.1:9051
SocksPort 127.0.0.1:9055
